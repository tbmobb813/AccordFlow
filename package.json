{
  "name": "accordflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @pest-crm/database prisma migrate dev",
    "db:generate": "pnpm --filter @pest-crm/database prisma generate",
    "db:studio": "pnpm --filter @pest-crm/database prisma studio"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "prettier": "^3.1.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3",
    "zod": "^4.3.6"
  },
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  }
}
